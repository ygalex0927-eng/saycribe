struct VoiceOrb: View {
    var recording: Bool
    var start: Date
    var pressed: Bool
    var source: AudioLevelSource = SimulatedAudioLevel()
    var diameter: CGFloat = 88

    @Environment(\\\\.accessibilityReduceMotion) private var reduceMotion
    @State private var level: Double = 0

    var body: some View {
        TimelineView(.animation(minimumInterval: 1.0 / 30, paused: reduceMotion)) { ctx in
            let elapsed = max(0, ctx.date.timeIntervalSince(start))
            let phase = reduceMotion ? 0 : elapsed
            ZStack {
                Canvas { context, size in
                    let center = CGPoint(x: size.width / 2, y: size.height / 2)
                    if recording {
                        ScribeVoiceContours.draw(in: context, center: center,
                                                 radius: diameter / 2, level: level, time: phase)
                        // 进度独立于声纹，仍保留原来的 60 秒语义。
                        var progress = Path()
                        progress.addArc(center: center, radius: diameter / 2 + 9,
                                        startAngle: .degrees(-90),
                                        endAngle: .degrees(-90 + 360 * min(1, elapsed / 60)),
                                        clockwise: false)
                        context.stroke(progress, with: .color(SaycribeColor.orange),
                                       style: StrokeStyle(lineWidth: 2.5, lineCap: .round))
                    } else {
                        idleCorona(in: context, center: center, time: phase)
                    }
                }
                // 声纹含描边限制在中心上下 80pt，既不改变占位，也不向提示字扩张。
                .frame(width: diameter + 120, height: diameter + 120)
                .clipped()

                Circle()
