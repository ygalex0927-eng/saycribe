                            Circle()
                                .fill(LinearGradient(
                                    colors: [SaycribeColor.orange.opacity(0.85),
                                             SaycribeColor.orangeDeep],
                                    startPoint: .topLeading, endPoint: .bottomTrailing))
                            Circle()
                                .strokeBorder(SaycribeColor.textPrimary.opacity(0.16), lineWidth: 0.75)
                        }
                    }
                    .frame(width: diameter, height: diameter)
                    .shadow(color: SaycribeColor.orangeDeep.opacity(0.35), radius: 16, y: 6)
                    .overlay {
                        if recording {
                            ScribeVoiceMark(level: level, time: phase)
                                .frame(width: diameter * 0.58, height: diameter * 0.58)
                        } else {
                            Image(systemName: \"mic.fill\")
                                .font(.system(size: diameter * 0.34, weight: .semibold))
                                .foregroundStyle(SaycribeColor.textPrimary)
                        }
