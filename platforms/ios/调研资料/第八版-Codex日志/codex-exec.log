// MARK: - 音量输入（第六版）
/// 音量 0…1。真实 App 里来自录音 RMS；DesignPreview 用模拟曲线。
protocol AudioLevelSource {
    func level(at t: TimeInterval) -> Double
}

/// 模拟曲线：大声 → 小声 → 停顿（≈0）→ 再大声，带自然抖动。
struct SimulatedAudioLevel: AudioLevelSource {
    var loudOnly = false
    /// 各段起点（秒，自录音开始）
    static let softAt: TimeInterval = 3.5
    static let pauseAt: TimeInterval = 6.5
    static let loudAgainAt: TimeInterval = 9.0

    func level(at t: TimeInterval) -> Double {
        guard t > 0 else { return 0 }
        let jitter = 0.5 + 0.5 * sin(t * 9.1) * sin(t * 3.7 + 1.3)
        let base: Double
        if loudOnly || t < Self.softAt || t >= Self.loudAgainAt {
            base = 0.72 + 0.26 * jitter
        } else if t < Self.pauseAt {
            base = 0.18 + 0.14 * jitter
        } else {
            base = 0.02 * jitter
        }
        let attack = min(1, t / 0.25)
        return max(0, min(1, base * attack))
    }
}

/// 录音主按钮：陶土橙圆 + 随音量舒展的碎弧花冠 + 60 秒进度弧。
struct VoiceOrb: View {
    var recording: Bool
    var start: Date
    var pressed: Bool
    var source: AudioLevelSource = SimulatedAudioLevel()
    var diameter: CGFloat = 88

    @State private var level: Double = 0

    var body: some View {
        ZStack {
            TimelineView(.animation(minimumInterval: 1.0 / 30)) { ctx in
                let t = max(0, ctx.date.timeIntervalSince(start))
                Canvas { c, size in
                    let ctr = CGPoint(x: size.width / 2, y: size.height / 2)
                    let r0 = diameter / 2
                    // 一条断开的不规则花冠，各短弧有独立相位与径向错位；没有闭合光晕。
                    // 半径硬上限 r0 + 56，含描边外沿默认 ≤ 101pt，不参与按钮缩放。
                    for fragment in 0..<13 {
                        let seed = Double(fragment)
                        let phase = t * 0.45 + seed * 2.39996
                        let breath = 0.5 + 0.5 * sin(t * 0.85 + seed * 0.3)
                        let spread = 5 + 35 * level
                        let stagger = (0.5 + 0.5 * sin(seed * 1.7)) * (2 + 7 * level)
                        let base = Double(r0) + 9 + spread - stagger + breath * 0.8
                        let centerAngle = seed / 13 * 2 * Double.pi + 0.04 * sin(phase)
                        let span = (0.19 + 0.11 * (0.5 + 0.5 * sin(seed * 3.1))) * (0.85 + 0.15 * level)
                        var path = Path()
                        for sample in 0...20 {
                            let u = Double(sample) / 20
                            let angle = centerAngle + (u - 0.5) * span
                            let petal = sin(angle * 3 + phase) * 0.62
                                + sin(angle * 5 - phase * 0.71) * 0.38
                            let radius = min(Double(r0) + 56, base + (0.5 + 7 * level) * petal)
                            let point = CGPoint(x: ctr.x + CGFloat(radius * cos(angle)),
                                                y: ctr.y + CGFloat(radius * sin(angle)))
                            if sample == 0 { path.move(to: point) } else { path.addLine(to: point) }
                        }
                        let shimmer = 0.5 + 0.5 * sin(phase + seed)
                        c.stroke(path, with: .color(SaycribeColor.orange.opacity(
                            0.12 + level * (0.28 + 0.30 * shimmer))),
                            style: StrokeStyle(lineWidth: 0.9 + level * 0.9, lineCap: .round))
                    }
                    if recording {
                        // 60 秒进度弧保持独立，始终贴近按钮。
                        let prog = min(1, max(0, t / 60))
                        var arc = Path()
                        arc.addArc(center: ctr, radius: r0 + 9, startAngle: .degrees(-90),
                                   endAngle: .degrees(-90 + 360 * prog), clockwise: false)
                        c.stroke(arc, with: .color(SaycribeColor.orange),
                                 style: StrokeStyle(lineWidth: 2.5, lineCap: .round))
                    }
                }
                .frame(width: diameter + 120, height: diameter + 120)
            }

            Circle()
                .fill(SaycribeColor.orangeDeep)
                .frame(width: diameter, height: diameter)
                .shadow(color: SaycribeColor.orangeDeep.opacity(0.35), radius: 16, y: 6)
                .overlay {
                    if recording {
                        LevelBars(level: level)
                    } else {
                        Image(systemName: "mic.fill")
                            .font(.system(size: diameter * 0.34, weight: .semibold))
                            .foregroundStyle(SaycribeColor.textPrimary)
                    }
                }
                .scaleEffect((1 + 0.12 * CGFloat(level)) * (pressed ? 0.96 : 1))
                .animation(Motion.press, value: pressed)
        }
        .frame(width: diameter + 120, height: diameter + 120)
        .task(id: recording) {
            var previous = Date()
            while !Task.isCancelled {
                let now = Date()
                let target = recording ? source.level(at: now.timeIntervalSince(start)) : 0
                // 时间相关的快起慢落：停顿时稳定收拢，不用高回弹弹簧反复追逐音量。
                let elapsed = now.timeIntervalSince(previous)
                let response = target > level ? 0.075 : 0.22
                level += (target - level) * (1 - exp(-elapsed / response))
                previous = now
                do {
                    try await Task.sleep(nanoseconds: 33_333_333)
                } catch {
                    return // recording 改变或视图退出时结束旧采样任务。
                }
            }
        }
    }
}

/// 暖白镜像声羽：九条沿浅弧展开，成对跳动，停顿时收成细小的弧形刻度。
struct LevelBars: View {
    var level: Double
    var count = 9

    var body: some View {
        TimelineView(.animation(minimumInterval: 1.0 / 30)) { ctx in
            let t = ctx.date.timeIntervalSinceReferenceDate
            HStack(spacing: 2.5) {
                ForEach(0..<count, id: \.self) { i in
                    let center = Double(count - 1) / 2
                    let position = Double(i) - center
                    let distance = abs(position) / max(1, center)
                    let envelope = 1 - 0.55 * distance
                    let syllable = 0.65 + 0.35 * sin(t * 7.2 - abs(position) * 0.85)
                    Capsule()
                        .fill(SaycribeColor.textPrimary)
                        .frame(width: 3, height: 4 + CGFloat(level * envelope * syllable) * 28)
                        .rotationEffect(.degrees(position * 5))
                        .offset(y: CGFloat(distance * distance) * 7 - 3)
                }
            }
            .frame(height: 40)
        }
    }
}

/// Logo 旁状态点 + 等宽标签
struct BrandStatusTag: View {
    var live: Bool
    var tag: String
    var body: some View {
        HStack(spacing: 6) {
            Circle()
                .fill(live ? SaycribeColor.orangeDeep : SaycribeColor.textTertiary)
                .frame(width: 6, height: 6)
            Text(tag)
                .font(SaycribeType.overline)
                .foregroundStyle(SaycribeColor.textSecondary)
        }
        .padding(.horizontal, 8).padding(.vertical, 4)
        .background(Capsule().stroke(SaycribeColor.border, lineWidth: 1))
    }
}

