                let now = Date()
                let target = recording ? min(1, max(0, source.level(at: now.timeIntervalSince(start)))) : 0
                // 75ms 起音、220ms 收音：跟随音节，不在停顿时抖动或弹跳。
                let elapsed = now.timeIntervalSince(previous)
                let response = target > level ? 0.075 : 0.22
                level += (target - level) * (1 - exp(-elapsed / response))
                previous = now
                do {
                    try await Task.sleep(nanoseconds: 33_333_333)
                } catch {
                    return // 录音切换或视图退出时取消采样。
                }
            }
        }
    }

    /// 空闲态沿用原有细碎花冠，不改麦克风按钮的设计。
    private func idleCorona(in context: GraphicsContext, center: CGPoint, time: Double) {
        for fragment in 0..<13 {
            let seed = Double(fragment)
            let phase = time * 0.45 + seed * 2.39996
            let breath = 0.5 + 0.5 * sin(time * 0.85 + seed * 0.3)
            let spread = 5 + 35 * level
            let stagger = (0.5 + 0.5 * sin(seed * 1.7)) * (2 + 7 * level)
            let base = Double(diameter / 2) + 9 + spread - stagger + breath * 0.8
            let centerAngle = seed / 13 * 2 * Double.pi + 0.04 * sin(phase)
            let span = (0.19 + 0.11 * (0.5 + 0.5 * sin(seed * 3.1))) * (0.85 + 0.15 * level)
            var path = Path()
            for sample in 0...20 {
                let angle = centerAngle + (Double(sample) / 20 - 0.5) * span
                let petal = sin(angle * 3 + phase) * 0.62 + sin(angle * 5 - phase * 0.71) * 0.38
                let radius = min(Double(diameter / 2) + 56, base + (0.5 + 7 * level) * petal)
                let point = CGPoint(x: center.x + radius * cos(angle), y: center.y + radius * sin(angle))
                if sample == 0 { path.move(to: point) } else { path.addLine(to: point) }
            }
            let shimmer = 0.5 + 0.5 * sin(phase + seed)
            context.stroke(path, with: .color(SaycribeColor.orange.opacity(
                0.12 + level * (0.28 + 0.30 * shimmer))),
                style: StrokeStyle(lineWidth: 0.9 + level * 0.9, lineCap: .round))
        }
    }
}

/// 三对开放声纹如纸上的等高线。大声主要向左右展开，底部没有向外传播的波环。
private enum ScribeVoiceContours {
    static func draw(in context: GraphicsContext, center: CGPoint,
                     radius: CGFloat, level: Double, time: Double) {
        for layer in 0..<3 {
            let depth = Double(layer)
            let horizontal = Double(radius) + 12 + depth * (3 + 8 * level) + 12 * level
            let vertical = min(72, Double(radius) + 7 + depth * (3 + 3 * level) + 4 * level)
            for side in 0..<2 {
                var contour = Path()
                for sample in 0...72 {
                    let u = Double(sample) / 72
                    let angle = (-0.42 + u * 0.84) * Double.pi + Double(side) * Double.pi
                    // 起伏仅由音量放大；相位只负责让左右声纹自然错开。
                    let ripple = level * (2.2 * sin(3 * angle + time * 2.1 - depth * 0.6)
                                          + 1.2 * sin(5 * angle - time * 1.4))
                    let x = (horizontal + ripple) * cos(angle)
                    let y = (vertical + ripple * 0.55) * sin(angle)
                    let point = CGPoint(x: center.x + x, y: center.y + y)
                    if sample == 0 { contour.move(to: point) } else { contour.addLine(to: point) }
                }
                let opacity = (0.16 + 0.48 * level) * (1 - depth * 0.22)
                context.stroke(contour, with: .linearGradient(
                    Gradient(stops: [
                        .init(color: SaycribeColor.orangeDeep.opacity(opacity * 0.12), location: 0),
                        .init(color: SaycribeColor.orange.opacity(opacity), location: 0.45),
                        .init(color: SaycribeColor.orangeDeep.opacity(opacity * 0.25), location: 1)
                    ]),
                    startPoint: CGPoint(x: center.x, y: center.y - vertical),
                    endPoint: CGPoint(x: center.x, y: center.y + vertical)),
                    style: StrokeStyle(lineWidth: 1.15 - depth * 0.15, lineCap: .round))
            }
        }
    }
}

/// 一笔 S：两段圆润笔锋随响度张开，停顿仍留一个清晰、安静的 Saycribe 签名。
private struct ScribeVoiceMark: View {
    var level: Double
    var time: Double

    var body: some View {
        Canvas { context, size in
            let center = CGPoint(x: size.width / 2, y: size.height / 2)
            let unit = size.width / 52
            let sway = level * sin(time * 4.2) * 1.5
            let bow = 15 + level * 7
            let height = 13 + level * 4
            func point(_ x: Double, _ y: Double) -> CGPoint {
                CGPoint(x: center.x + x * unit, y: center.y + y * unit)
            }
            var signature = Path()
            signature.move(to: point(12 + level * 2, -height + 1))
            signature.addCurve(to: point(-1, 0),
                               control1: point(-bow + sway, -height - 11),
                               control2: point(-bow - 7, -3 - sway))
            signature.addCurve(to: point(-13 - level, height - 1),
                               control1: point(bow + 8, 3 + sway),
                               control2: point(bow - sway, height + 12))
            context.stroke(signature, with: .color(SaycribeColor.textPrimary),
                           style: StrokeStyle(lineWidth: (3.8 + level * 0.5) * unit,
                                              lineCap: .round, lineJoin: .round))
        }
        .accessibilityHidden(true)
    }
}

