// MARK: - 音量输入（第六版）
/// 音量 0…1。真实 App 里来自录音 RMS；DesignPreview 用模拟曲线。
protocol AudioLevelSource {
    func level(at t: TimeInterval) -> Double
}

/// 模拟曲线：大声 → 小声 → 停顿（≈0）→ 再大声，带自然抖动。
struct SimulatedAudioLevel: AudioLevelSource {
    var loudOnly = false
    /// 各段起点（秒，自录音开始）
    static let softAt: TimeInterval = 3.5
    static let pauseAt: TimeInterval = 6.5
    static let loudAgainAt: TimeInterval = 9.0

    func level(at t: TimeInterval) -> Double {
        guard t > 0 else { return 0 }
        let jitter = 0.5 + 0.5 * sin(t * 9.1) * sin(t * 3.7 + 1.3)
        let base: Double
        if loudOnly || t < Self.softAt || t >= Self.loudAgainAt {
            base = 0.72 + 0.26 * jitter
        } else if t < Self.pauseAt {
            base = 0.18 + 0.14 * jitter
        } else {
            base = 0.02 * jitter
        }
        let attack = min(1, t / 0.25)
        return max(0, min(1, base * attack))
    }
}

/// 录音主按钮：陶土橙圆 + 音量联动缩放 + 3 层橙色正弦波纹环 + 等宽计时进度弧。
struct VoiceOrb: View {
    var recording: Bool
    var start: Date
    var pressed: Bool
    var source: AudioLevelSource = SimulatedAudioLevel()
    var diameter: CGFloat = 88

    @State private var scale: CGFloat = 1
    @State private var level: Double = 0

    var body: some View {
        ZStack {
            TimelineView(.animation) { ctx in
                let t = ctx.date.timeIntervalSince(start)
                Canvas { c, size in
                    let ctr = CGPoint(x: size.width / 2, y: size.height / 2)
                    let r0 = diameter / 2
                    for ring in (0..<3).reversed() {
                        // 层间延迟：外层晚 0.14s × 层号 响应
                        let lv = recording ? source.level(at: t - Double(ring) * 0.14) : 0
                        let breathe = 0.5 + 0.5 * sin(t * 1.6 - Double(ring) * 0.8)
                        let radius = r0 + CGFloat(ring + 1) * (4 + 12 * lv) + CGFloat(breathe) * 1.5
                        let amp = CGFloat(0.6 + 6.5 * lv)
                        let lobes = Double(5 + ring * 2)
                        let ph = t * (1.3 + 0.45 * Double(ring))
                        var p = Path()
                        for k in 0...120 {
                            let a = Double(k) / 120 * 2 * .pi
                            let rr = radius + amp * CGFloat(sin(lobes * a + ph) + 0.45 * sin((lobes + 3) * a - ph * 1.3))
                            let pt = CGPoint(x: ctr.x + rr * CGFloat(cos(a)), y: ctr.y + rr * CGFloat(sin(a)))
                            if k == 0 { p.move(to: pt) } else { p.addLine(to: pt) }
                        }
                        p.closeSubpath()
                        let fade = Double(ring) * 0.025
                        c.fill(p, with: .color(SaycribeColor.orangeDeep.opacity(max(0.03, 0.05 + 0.12 * lv - fade))))
                        c.stroke(p, with: .color(SaycribeColor.orange.opacity(max(0.08, 0.16 + 0.36 * lv - fade * 2))),
                                 lineWidth: 1.2)
                    }
                    if recording {
                        // 60 秒进度弧
                        let prog = min(1, max(0, t / 60))
                        var arc = Path()
                        arc.addArc(center: ctr, radius: r0 + 6, startAngle: .degrees(-90),
                                   endAngle: .degrees(-90 + 360 * prog), clockwise: false)
